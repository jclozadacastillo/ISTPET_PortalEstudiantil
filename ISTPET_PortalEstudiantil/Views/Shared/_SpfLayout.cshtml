@using System.IO
@using System.Text.Encodings.Web
@using Newtonsoft.Json
@{
    Layout = null;
    Context.Response.ContentType = "application/json; charset=utf-8";
    var title = "ISTPET: PORTAL ESTUDIANTIL " + Convert.ToString(ViewData["Title"])?.ToUpper();
    
    var writer = new StringWriter();
    RenderBody().WriteTo(writer, HtmlEncoder.Default);
    var bodyHtml = writer.ToString();
    
    var spfResponse = new {
        title = title,
        body = new Dictionary<string, string> {
            { "portal-content", bodyHtml }
        }
    };
}
@Html.Raw(JsonConvert.SerializeObject(spfResponse))
