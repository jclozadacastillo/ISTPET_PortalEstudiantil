@inject ISessionAlumnos _auth;
@{
    var _version = $"?v={DateTime.Now.Ticks}";
    var _pendientes = _auth.evaluacionesPendientes();
}
<!DOCTYPE html>
<html lang="es-ec">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title> ISTPET: PORTAL ESTUDIANTIL @Convert.ToString(ViewData["Title"])?.ToUpper()</title>
    <link rel="icon" type="image/png" href="~/template/img/icono.png">
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900|Roboto+Slab:400,700" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link id="pagestyle" href="~/template/css/material-dashboard.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <link href="~/template/css/portal-layout.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <link href="~/utilities/toast/toast.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <script defer src="~/template/js/core/popper.min.js"></script>
    <script defer src="~/template/js/core/bootstrap.min.js"></script>
    <script defer src="~/utilities/axios/axios.min.js?v=@DateTime.Now.Ticks"></script>
<script>
    let urlActual = window.location.href;
    if (urlActual.toLowerCase().includes("appestudiantes") && !urlActual.includes("appEstudiantes")) {
        let urlCorregida = urlActual.replace(/appestudiantes/gi, "appEstudiantes");
        window.location.replace(urlCorregida);
    }
    const _route = top.location.href.toLowerCase().indexOf("localhost:") >= 0 ? "../../" : "../../../appEstudiantes/";
</script>


    <script defer src="~/utilities/toast/toast.js?v=@DateTime.Now.Ticks"></script>
    <script defer>var _token = `@(Html.AntiForgeryToken())`;</script>
    <script defer src="~/js/token.js"></script>
    <script defer src="~/utilities/forms.js?v=@DateTime.Now.Ticks"></script>
    <script defer src="~/utilities/spf/spf.js?v=@DateTime.Now.Ticks"></script>
    <script defer src="~/template/js/material-dashboard.js?v=3.0.2"></script>
    <script defer src="~/js/siteLayout.js?v=@DateTime.Now.Ticks"></script>
</head>
<body class="g-sidenav-show  bg-gray-400">
    <aside class="sidenav navbar navbar-vertical navbar-expand-xs border-0 border-radius-xl my-1 fixed-start ms-1 bg-gradient-dark" id="sidenav-main">
        <div class="sidenav-header">
            <i class="fas fa-times p-3 cursor-pointer text-white opacity-5 position-absolute end-0 top-0 d-none d-xl-none" aria-hidden="true" id="iconSidenav"></i>
            <a class="navbar-brand2 m-0 spf-link" href="~/">
                <img src="~/template/img/logo-blanco.png" width="127" alt="ISTPET">
            </a>
        </div>
        <hr class="horizontal light mt-0 mb-2">
        <div class="collapse navbar-collapse w-auto portal-sidenav-body" id="sidenav-collapse-main">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link text-white spf-link" data-menu='sistema' href="~/">
                        <div class="text-white text-center me-2 d-flex align-items-center justify-content-center">
                            <i class="bi-house text-lg"></i>
                        </div>
                        <span class="nav-link-text ms-1">Inicio</span>
                    </a>
                </li>
                <li class="nav-item mt-3">
                    <h6 class="ps-4 ms-2 text-uppercase text-xs text-white font-weight-bolder opacity-8">Académico</h6>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white spf-link" data-menu='calificaciones' href="~/Sistema/Calificaciones">
                        <div class="text-white text-center me-2 d-flex align-items-center justify-content-center">
                            <i class="bi-file-earmark-spreadsheet text-lg"></i>
                        </div>
                        <span class="nav-link-text ms-1">Calificaciones</span>
                    </a>
                </li>
                @if (_pendientes > 0)
                {
                    <li class="nav-item mt-3">
                        <h6 class="ps-4 ms-2 text-uppercase text-xs text-white font-weight-bolder opacity-8">Evaluaciones</h6>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white d-flex align-items-center justify-content-between spf-link" data-menu='evaluaciondocente' href="~/Sistema/EvaluacionDocente">
                            <div class="d-flex align-items-center">
                                <div class="text-white text-center me-2 d-flex align-items-center justify-content-center">
                                    <i class="bi-file-check text-lg"></i>
                                </div>
                                <span class="nav-link-text ms-1">Evaluación Docente</span>
                            </div>
                            <span class="badge bg-danger text-white rounded-pill badge-custom me-1">@_pendientes</span>
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item mt-3">
                        <h6 class="ps-4 ms-2 text-uppercase text-xs text-white font-weight-bolder opacity-8">Evaluaciones</h6>
                    </li>

                    <li class="nav-item" title="Ninguna evaluación docente pendiente">
                        <a class="nav-link text-white opacity-7 d-flex align-items-center justify-content-between" href="javascript:;" style="pointer-events:none">
                            <div class="d-flex align-items-center">
                                <div class="text-white text-center me-2 d-flex align-items-center justify-content-center">
                                    <i class="bi-file-check text-lg"></i>
                                </div>
                                <span class="nav-link-text ms-1">Evaluación Docente</span>
                            </div>
                            <i class="bi-check-circle-fill text-success text-sm me-1" title="Sin evaluaciones pendientes"></i>
                        </a>
                    </li>
                }
                <li class="nav-item mt-3">
                    <h6 class="ps-4 ms-2 text-uppercase text-xs text-white font-weight-bolder opacity-8">Servicios</h6>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="https://elibro.net/es/lc/institutotraversari/login_usuario/" target="_blank">
                        <div class="text-white text-center me-2 d-flex align-items-center justify-content-center">
                            <i class="bi-book text-lg"></i>
                        </div>
                        <span class="nav-link-text ms-1">Biblioteca virtual</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="https://portal.office.com/" target="_blank">
                        <div class="text-white text-center me-2 d-flex align-items-center justify-content-center">
                            <i class="bi-envelope-check text-lg"></i>
                        </div>
                        <span class="nav-link-text ms-1">Correo institucional</span>
                    </a>
                </li>
            </ul>
        </div>

    </aside>
    <main class="main-content position-relative border-radius-lg portal-main">
        <!-- Navbar -->
        <nav class="navbar navbar-main position-sticky bg-white t-4 top-1 z-index-sticky navbar-expand-lg px-0 mx-4 border-radius-xl" id="navbarBlur" navbar-scroll="true">
            <div class="container-fluid py-1 px-3">
                <div class="collapse navbar-collapse mt-sm-0  me-md-0 me-sm-4" id="navbar">
                    <div class="ms-md-auto pe-md-3 d-flex align-items-center">
                        <div class="nav-item d-xl-none ps-3 d-flex align-items-center">
                            <a href="javascript:;" class="nav-link text-body p-0" id="iconNavbarSidenav">
                                <div class="sidenav-toggler-inner">
                                    <i class="sidenav-toggler-line"></i>
                                    <i class="sidenav-toggler-line"></i>
                                    <i class="sidenav-toggler-line"></i>
                                </div>
                            </a>
                        </div>
                    </div>
                    <ul class="navbar-nav justify-content-end">
                        <li class="nav-item dropdown pe-2 d-flex align-items-center">
                            <div class="user-avatar-pill shadow-xs" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="avatar-circle-sm overflow-hidden d-flex align-items-center justify-content-center" id="layoutUserAvatarContainer">
                                    @if (!string.IsNullOrEmpty(_auth.get("archivofoto")))
                                    {
                                        <img src="~/@(_auth.get("archivofoto"))?v=@DateTime.Now.Ticks" class="w-100 h-100 rounded-circle" style="object-fit: cover; object-position: center;" alt="Perfil" onerror="this.parentElement.innerHTML='<i class=\'bi-person-fill\'></i>';" />
                                    }
                                    else
                                    {
                                        <i class="bi-person-fill"></i>
                                    }
                                </div>
                                <span class="d-none d-sm-inline text-navbar-user text-truncate" style="max-width: 220px;">@_auth.getName()</span>
                                <i class="bi-chevron-down text-xs ms-1 text-muted"></i>
                            </div>
                            <ul class="dropdown-menu dropdown-menu-end p-2 shadow-lg border-0 dropdown-menu-portal" aria-labelledby="dropdownMenuButton">
                                <li class="px-3 py-2 bg-light-subtle rounded-3 mb-2 border-bottom">
                                    <span class="text-uppercase text-xxs font-weight-bold text-muted d-block">Estudiante ISTPET</span>
                                    <span class="text-sm font-weight-bold text-dark text-truncate d-block">@_auth.getName()</span>
                                </li>
                                <li>
                                    <a class="dropdown-item border-radius-md py-2 px-3 dropdown-item-portal spf-link" href="~/Sistema/Perfil">
                                        <div class="d-flex align-items-center">
                                            <div class="dropdown-icon-box dropdown-icon-profile me-3">
                                                <i class="bi-person-gear"></i>
                                            </div>
                                            <div class="d-flex flex-column justify-content-center">
                                                <h6 class="text-sm font-weight-bold text-dark mb-0">Mi Perfil</h6>
                                                <p class="text-xs text-secondary mb-0">Ver y editar información</p>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <hr class="dropdown-divider my-2">
                                </li>
                                <li>
                                    <a class="dropdown-item border-radius-md py-2 px-3 dropdown-item-logout" onclick="salir()" href="javascript:;">
                                        <div class="d-flex align-items-center">
                                            <div class="dropdown-icon-box dropdown-icon-logout me-3">
                                                <i class="bi-box-arrow-right"></i>
                                            </div>
                                            <div class="d-flex flex-column justify-content-center">
                                                <h6 class="text-sm font-weight-bold text-danger mb-0">Cerrar Sesión</h6>
                                                <p class="text-xs text-secondary mb-0">Salir de la plataforma</p>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
        <!-- End Navbar -->
        <div class="container-fluid portal-main-container">
            <div class="row main portal-main-row" id="portal-content">
                @RenderBody()
            </div>
            <div class="footer">
                <div class="row ">
                    <div class="w-100  no-wrap text-footer ">
                        <span class="pe-1">© @DateTime.Now.Year </span><a href="https://institutotraversari.edu.ec/" target="_blank">Instituto Superior Tecnológico Mayor Pedro Traversari</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
