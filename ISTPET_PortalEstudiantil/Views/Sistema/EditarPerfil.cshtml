@{
    ViewData["Title"] = "Editar Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="loader pt-3 text-center">
    <div class="spinner-grow text-primary spinner-grow-sm" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <div class="spinner-grow text-primary spinner-grow-sm" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
    <div class="spinner-grow text-primary spinner-grow-sm" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div class="w-100 container-main p-0" hidden>
    <!-- Banner Header Institucional -->
    <div class="card border-0 shadow-sm border-radius-xl overflow-hidden" style="background: linear-gradient(135deg, #151b3d 0%, #1f295b 100%); border-left: 4px solid #c59b27 !important;">
        <div class="card-body p-4 text-white">
            <div class="row align-items-center">
                <div class="col-auto">
                    <div class="portal-card-icon-box me-1" style="width: 48px; height: 48px; min-width: 48px; min-height: 48px;">
                        <i class="bi-pencil-square text-white fs-4"></i>
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge border border-white-50 text-white font-weight-bold text-xxs uppercase tracking-wider" style="background: rgba(255, 255, 255, 0.15);">ESTUDIANTE</span>
                    </div>
                    <h3 class="text-white mb-0 font-weight-bold" style="letter-spacing: -0.01em;">Editar Perfil Estudiantil</h3>
                    <p class="text-white-50 text-xs mb-0 mt-1">Actualiza tus datos de contacto y fotografía de cuenta personal.</p>
                </div>
                <div class="col-12 col-md-auto mt-2 mt-md-0 text-md-end">
                    <a class="btn btn-white text-primary font-weight-bold border-radius-md px-3 py-2 shadow-sm btn-sm" href="~/Sistema/Perfil" style="background: #ffffff !important; color: #1f295b !important; border: 1px solid #e2e8f0;">
                        <i class="bi-arrow-left me-1"></i> Volver al Perfil
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Formulario Principal -->
    <form id="formEditarPerfil" enctype="multipart/form-data">
        <div class="row g-3 p-0 m-0" style="margin-top: 0 !important;">
            <!-- Columna Izquierda: Fotografía -->
            <div class="col-lg-4 ps-0 pe-lg-2">
                <div class="card shadow-sm border-0 border-radius-xl h-100">
                    <div class="card-header bg-transparent py-3 px-4 border-bottom border-light">
                        <div class="d-flex align-items-center gap-3">
                            <div class="portal-card-icon-box" style="width: 38px; height: 38px; min-width: 38px; min-height: 38px;">
                                <i class="bi-camera-fill text-white fs-6"></i>
                            </div>
                            <h6 class="mb-0 text-dark font-weight-bold">Fotografía de Perfil</h6>
                        </div>
                    </div>
                    <div class="card-body p-3 px-4 text-center d-flex flex-column align-items-center justify-content-between">
                        <div class="w-100">
                            <div class="profile-photo-preview border-radius-lg overflow-hidden shadow-xs mx-auto mb-3" style="width: 140px; height: 140px; border: 2px dashed #cbd5e1; background: #f8fafc;">
                                <img id="previewFoto" src="#" alt="Vista previa" style="display: none; width: 100%; height: 100%; object-fit: cover;">
                            </div>
                            <p class="text-secondary text-xs mb-3">Imagen visible en su cuenta del portal estudiantil (Máx. 500 KB).</p>
                        </div>
                        <div class="w-100">
                            <label for="foto" class="form-label text-xxs font-weight-bold text-uppercase text-secondary mb-1">Cargar nueva imagen</label>
                            <input type="file" class="form-control form-control-sm border-radius-md" id="foto" name="foto" accept="image/*" onchange="validarYMostrarFoto()">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha: Datos de Contacto -->
            <div class="col-lg-8 pe-0 ps-lg-2">
                <div class="card shadow-sm border-0 border-radius-xl h-100">
                    <div class="card-header bg-transparent py-3 px-4 border-bottom border-light">
                        <div class="d-flex align-items-center gap-3">
                            <div class="portal-card-icon-box" style="width: 38px; height: 38px; min-width: 38px; min-height: 38px;">
                                <i class="bi-person-lines-fill text-white fs-6"></i>
                            </div>
                            <h6 class="mb-0 text-dark font-weight-bold">Datos de Contacto y Residencia</h6>
                        </div>
                    </div>
                    <div class="card-body p-3 px-4 d-flex flex-column justify-content-between">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label text-xxs font-weight-bold text-uppercase text-secondary mb-1" for="direccion">
                                        <i class="bi-map me-1" style="color: #1f295b;"></i> Dirección Domiciliaria
                                    </label>
                                    <input type="text" class="form-control form-control-sm border-radius-md" id="direccion" name="direccion" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label text-xxs font-weight-bold text-uppercase text-secondary mb-1" for="email">
                                        <i class="bi-envelope me-1" style="color: #1f295b;"></i> Email Personal
                                    </label>
                                    <input type="email" class="form-control form-control-sm border-radius-md" id="email" name="email" required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label text-xxs font-weight-bold text-uppercase text-secondary mb-1" for="telefono">
                                        <i class="bi-telephone me-1" style="color: #1f295b;"></i> Teléfono Fijo
                                    </label>
                                    <input type="text" class="form-control form-control-sm border-radius-md" id="telefono" name="telefono">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label text-xxs font-weight-bold text-uppercase text-secondary mb-1" for="celular">
                                        <i class="bi-phone me-1" style="color: #1f295b;"></i> Celular
                                    </label>
                                    <input type="text" class="form-control form-control-sm border-radius-md" id="celular" name="celular" required>
                                </div>
                            </div>
                            <div class="col-md-6 etnia-field">
                                <div class="form-group">
                                    <label class="form-label text-xxs font-weight-bold text-uppercase text-secondary mb-1" for="idEtnia">
                                        <i class="bi-people me-1" style="color: #1f295b;"></i> Etnia
                                    </label>
                                    <select class="form-select form-select-sm border-radius-md" id="idEtnia" name="idEtnia" required>
                                        <option value="">Seleccione...</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Botones de Accion -->
                        <div class="pt-3 mt-4 border-top d-flex justify-content-end gap-2">
                            <a class="btn btn-light btn-sm border-radius-md px-4 mb-0" href="~/Sistema/Perfil">Cancelar</a>
                            <button type="button" class="btn btn-primary btn-sm border-radius-md px-4 mb-0" onclick="guardar()" style="background: #1f295b !important; border: none;">
                                <i class="bi-check2-circle me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script defer src="~/js/siteEditarPerfil.js?v=@DateTime.Now.Ticks"></script>

