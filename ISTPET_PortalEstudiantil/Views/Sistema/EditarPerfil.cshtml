@{
    ViewData["Title"] = "Editar Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="loader profile-edit-loader pt-4 text-center">
    <div class="spinner-grow text-dark spinner-grow-sm" role="status">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>

<div class="w-100 container-main profile-edit-page" hidden>
    <div class="card-container profile-edit-container">
        <div class="card profile-edit-card">
            <div class="profile-edit-header">
                <div>
                    <span class="profile-edit-eyebrow">Cuenta estudiantil</span>
                    <h5 class="profile-edit-title m-0">Editar perfil</h5>
                    <p class="text-sm mb-0">Datos de contacto y fotografia.</p>
                </div>
            </div>

            <form id="formEditarPerfil" enctype="multipart/form-data" class="profile-edit-form">
                <div class="profile-edit-grid">
                    <section class="profile-photo-panel" aria-label="Fotografia">
                        <div class="profile-photo-preview">
                            <img id="previewFoto" src="#" alt="Vista previa" style="display: none;">
                        </div>
                        <div class="profile-photo-copy">
                            <h6 class="mb-1">Fotografia</h6>
                            <p class="text-muted text-xs mb-0">Imagen visible en su cuenta estudiantil.</p>
                        </div>
                        <input type="file" class="form-control form-control-sm" id="foto" name="foto" accept="image/*" onchange="validarYMostrarFoto()">
                    </section>

                    <section class="profile-fields-panel" aria-label="Datos personales">
                        <div class="profile-section-title">
                            <i class="bi bi-person-lines-fill"></i>
                            <span>Datos de contacto</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-lg-6">
                                <div class="form-group profile-field">
                                    <small>Direccion</small>
                                    <input type="text" class="form-control form-control-sm" id="direccion" name="direccion" required>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group profile-field">
                                    <small>Email personal</small>
                                    <input type="email" class="form-control form-control-sm" id="email" name="email" required>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group profile-field">
                                    <small>Telefono</small>
                                    <input type="text" class="form-control form-control-sm" id="telefono" name="telefono">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="form-group profile-field">
                                    <small>Celular</small>
                                    <input type="text" class="form-control form-control-sm" id="celular" name="celular" required>
                                </div>
                            </div>
                            <div class="col-lg-6 etnia-field">
                                <div class="form-group profile-field">
                                    <small>Etnia</small>
                                    <select class="form-select form-select-sm" id="idEtnia" name="idEtnia" required>
                                        <option value="">Seleccione...</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="profile-edit-actions">
                    <a class="btn btn-light btn-sm mb-0" href="~/Sistema/Perfil">Cancelar</a>
                    <button type="button" class="btn bg-gradient-dark btn-sm mb-0" onclick="guardar()">
                        <i class="bi bi-check2-circle me-1"></i>Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script defer src="~/js/siteEditarPerfil.js?v=@DateTime.Now.Ticks"></script>
