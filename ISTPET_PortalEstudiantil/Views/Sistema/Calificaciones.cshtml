@{
  ViewData["Title"] = "Calificaciones";
}

<link rel="stylesheet" href="~/template/css/portal-calificaciones.css" asp-append-version="true" />

<div class="w-100 container-main p-0">
  <!-- Tarjeta Unificada Compacta (Encabezado + Filtros) -->
  <div class="card shadow-sm border-0 border-radius-xl overflow-hidden portal-card-space">
    <div class="card-body p-3 px-4">
      <form enctype="multipart/form-data" id="frm">
        <div class="row align-items-center g-3">
          <!-- Titulo -->
          <div class="col-lg-4">
            <div class="d-flex align-items-center mb-0">
              <div class="portal-card-icon-box me-3" style="margin-right: 1.25rem !important;">
                <i class="bi-file-earmark-spreadsheet-fill portal-icon-white fs-5"></i>
              </div>
              <div>
                <h5 class="mb-0 font-weight-bold text-dark" style="letter-spacing: -0.01em;">Calificaciones</h5>
                <p class="text-muted text-xs p-0 m-0">Selecciona carrera y nivel de consulta</p>
              </div>
            </div>
          </div>

          <!-- Filtros -->
          <div class="col-lg-4 col-md-6">
            <label class="form-label text-xxs font-weight-bold text-uppercase text-secondary mb-1 d-flex align-items-center gap-1" for="idCarrera">
              <i class="bi-mortarboard" style="color: #1f295b !important; font-size: 0.9rem; line-height: 1;"></i> Carrera
            </label>
            <select class="form-select form-select-sm text-uppercase border-radius-md shadow-none" id="idCarrera" name="idCarrera" style="border-color: #cbd5e1;">
              <option value="">Seleccione</option>
              @if (ViewBag.Carreras != null)
              {
                foreach (var c in ViewBag.Carreras)
                {
                  <option value="@c.idCarrera">@c.Carrera</option>
                }
              }
            </select>
          </div>
          <div class="col-lg-4 col-md-6">
            <label class="form-label text-xxs font-weight-bold text-uppercase text-secondary mb-1 d-flex align-items-center gap-1" for="idMatricula">
              <i class="bi-layers" style="color: #1f295b !important; font-size: 0.9rem; line-height: 1;"></i> Nivel / Periodo
            </label>
            <select class="form-select form-select-sm text-uppercase border-radius-md shadow-none" id="idMatricula" name="idMatricula" style="border-color: #cbd5e1;">
              <option value="">Seleccione una carrera</option>
            </select>
          </div>
        </div>
      </form>
    </div>
  </div>

  <section class="container-table portal-grades" hidden aria-labelledby="grades-title">
    <header class="grades-heading">
      <div class="grades-heading-copy">
        <span class="grades-icon" aria-hidden="true"><i class="bi-journal-check"></i></span>
        <div><h2 id="grades-title">Calificaciones por asignatura</h2><p>Consulta tus parciales y el resultado final.</p></div>
      </div>
      <span class="grades-count" data-grades-count></span>
    </header>
    <div class="grades-scroll-hint"><i class="bi-arrow-left-right" aria-hidden="true"></i> Desliza la tabla para ver todas las notas</div>
    <div class="grades-table-wrap" role="region" aria-label="Tabla de calificaciones" tabindex="0">
      <table class="grades-table">
        <caption class="grades-sr-only">Calificaciones de las asignaturas del nivel y período seleccionados</caption>
        <colgroup><col class="grades-subject-col" /><col span="7" class="grades-number-col" /><col class="grades-average-col" /><col class="grades-status-col" /></colgroup>
        <thead>
          <tr class="grades-groups">
            <th rowspan="2" scope="col" class="grades-subject-header">Asignatura</th>
            <th colspan="3" scope="colgroup">Primer parcial</th>
            <th colspan="3" scope="colgroup" class="grades-group-start">Segundo parcial</th>
            <th colspan="3" scope="colgroup" class="grades-group-start grades-result-header">Resultado final</th>
          </tr>
          <tr class="grades-columns">
            <th scope="col" title="Examen Formativo I">Formativo<span>EFI</span></th>
            <th scope="col" title="Examen Práctico I">Práctico<span>EPI</span></th>
            <th scope="col" title="Parcial I">Parcial I<span>PI</span></th>
            <th scope="col" class="grades-group-start" title="Examen Formativo II">Formativo<span>EFII</span></th>
            <th scope="col" title="Examen Práctico II">Práctico<span>EPII</span></th>
            <th scope="col" title="Parcial II">Parcial II<span>PII</span></th>
            <th scope="col" class="grades-group-start" title="Examen Final / Supletorio">Examen<span>Final / supletorio</span></th>
            <th scope="col" class="grades-average-header">Promedio<span>Final</span></th>
            <th scope="col">Estado<span>De aprobación</span></th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <footer class="grades-legend"><i class="bi-info-circle" aria-hidden="true"></i><span>EFI / EFII: examen formativo · EPI / EPII: examen práctico · PI / PII: parcial.</span></footer>
  </section>
</div>

<script defer src="~/js/siteCalificaciones.js?v=@DateTime.Now.Ticks"></script>


