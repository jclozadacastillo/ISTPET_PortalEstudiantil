@{
  ViewData["Title"] = "Inicio";
  Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row g-3 p-0 m-0" style="margin-top: -0.65rem !important;">
  <div class="col-xl-4 col-md-6 portal-card-space">
    <div class="portal-card h-100">
      <div class="portal-card-header">
        <div class="d-flex align-items-center mb-3">
          <div class="portal-card-icon-box me-3.5" style="margin-right: 1.25rem !important;">
            <i class="bi-file-earmark-spreadsheet-fill portal-icon-gold fs-5"></i>
          </div>
          <h5 class="mb-0 font-weight-bold text-dark">Calificaciones</h5>
        </div>
        <p class="text-sm text-secondary mb-3">Revisa tu historial académico, parciales y promedio general.</p>
        <div class="portal-card-img-wrapper">
          <img src="~/template/img/calificaciones-istpet.png" alt="Calificaciones" />
        </div>
      </div>
      <div class="portal-card-footer text-end mt-auto pt-3">
        <a class="btn-portal-action" href="~/Sistema/Calificaciones">
          Ingresar <i class="bi-arrow-right text-xs ms-1"></i>
        </a>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 portal-card-space">
    <div class="portal-card h-100">
      <div class="portal-card-header">
        <div class="d-flex align-items-center mb-3">
          <div class="portal-card-icon-box me-3.5" style="margin-right: 1.25rem !important;">
            <i class="bi-book-fill portal-icon-gold fs-5"></i>
          </div>
          <h5 class="mb-0 font-weight-bold text-dark">Biblioteca Virtual</h5>
        </div>
        <p class="text-sm text-secondary mb-3">Accede a miles de libros digitales y recursos de investigación.</p>
        <div class="portal-card-img-wrapper">
          <img src="~/template/img/biblioteca.png" alt="Biblioteca Virtual" />
        </div>
      </div>
      <div class="portal-card-footer text-end mt-auto pt-3">
        <a class="btn-portal-action" href="https://elibro.net/es/lc/institutotraversari/login_usuario/" target="_blank">
          Ingresar <i class="bi-box-arrow-up-right text-xs ms-1"></i>
        </a>
      </div>
    </div>
  </div>

  <div class="col-xl-4 col-md-6 portal-card-space">
    <div class="portal-card h-100">
      <div class="portal-card-header">
        <div class="d-flex align-items-center mb-3">
          <div class="portal-card-icon-box me-3.5" style="margin-right: 1.25rem !important;">
            <i class="bi-envelope-check-fill portal-icon-gold fs-5"></i>
          </div>
          <h5 class="mb-0 font-weight-bold text-dark">Correo Institucional</h5>
        </div>
        <p class="text-sm text-secondary mb-3">Accede a tu correo institucional Microsoft 365 y sus servicios.</p>
        <div class="portal-card-img-wrapper">
          <img src="~/template/img/office-istpet.png" alt="Correo Institucional" />
        </div>
      </div>
      <div class="portal-card-footer text-end mt-auto pt-3">
        <a class="btn-portal-action" href="https://portal.office.com/" target="_blank">
          Ingresar <i class="bi-box-arrow-up-right text-xs ms-1"></i>
        </a>
      </div>
    </div>
  </div>
</div>






