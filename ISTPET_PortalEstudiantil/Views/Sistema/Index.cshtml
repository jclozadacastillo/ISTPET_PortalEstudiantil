@model AccesosInstitucionalesViewModel
@{
    ViewData["Title"] = "Inicio";
}

<link rel="stylesheet" href="~/template/css/portal-inicio.css" asp-append-version="true" />

<div class="w-100 container-main p-0 portal-home">
    <section class="portal-home-grid" aria-label="Accesos del portal estudiantil">
        <article class="portal-home-card">
            <div class="portal-home-content">
                <div class="portal-home-heading">
                    <div class="portal-home-icon" aria-hidden="true"><i class="bi-file-earmark-spreadsheet-fill"></i></div>
                    <h2>Calificaciones</h2>
                </div>
                <p class="portal-home-description">Revisa tu historial académico, parciales y promedio general.</p>
                <div class="portal-home-media">
                    <img src="~/template/img/calificaciones-istpet.png" alt="Estudiantes en el aula de ISTPET" />
                </div>
            </div>
            <footer class="portal-home-footer">
                <div class="portal-home-meta"><i class="bi-journal-check" aria-hidden="true"></i><span>Tu progreso académico</span></div>
                <a class="portal-home-action spf-link" href="~/Sistema/Calificaciones">Ver calificaciones <i class="bi-arrow-right" aria-hidden="true"></i></a>
            </footer>
        </article>

        <article class="portal-home-card">
            <div class="portal-home-content">
                <div class="portal-home-heading">
                    <div class="portal-home-icon" aria-hidden="true"><i class="bi-book-fill"></i></div>
                    <h2>Biblioteca virtual</h2>
                </div>
                <p class="portal-home-description">Accede a miles de libros digitales y recursos de investigación.</p>
                <div class="portal-home-media">
                    <img src="~/template/img/biblioteca.png" alt="Libros digitales de la biblioteca virtual ISTPET" />
                </div>
            </div>
            <footer class="portal-home-footer">
                <div class="portal-home-meta"><i class="bi-box-arrow-up-right" aria-hidden="true"></i><span>Se abre en una nueva pestaña</span></div>
                <a class="portal-home-action" href="https://elibro.net/es/lc/institutotraversari/login_usuario/" target="_blank" rel="noopener noreferrer">Abrir biblioteca <i class="bi-box-arrow-up-right" aria-hidden="true"></i></a>
            </footer>
        </article>

        <article class="portal-home-card">
            <div class="portal-home-content">
                <div class="portal-home-heading">
                    <div class="portal-home-icon" aria-hidden="true"><i class="bi-grid-fill"></i></div>
                    <h2>Accesos institucionales</h2>
                </div>
                <p class="portal-home-description">Tu correo institucional, aula virtual y grupos de conducción en un solo lugar.</p>
                <div class="portal-home-media">
                    <img src="~/template/img/office-istpet.png" alt="Servicios institucionales de Microsoft 365" />
                </div>
            </div>
            <footer class="portal-home-footer">
                <div class="portal-home-meta"><i class="bi-grid" aria-hidden="true"></i><span>Consulta tus servicios disponibles</span></div>
                <a class="portal-home-action" href="~/Sistema/AccesosInstitucionales">Ver accesos <i class="bi-arrow-right" aria-hidden="true"></i></a>
            </footer>
        </article>
    </section>
</div>






