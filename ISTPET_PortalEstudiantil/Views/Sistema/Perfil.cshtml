@model ISTPET_PortalEstudiantil.Models.sigafi_es.alumnos
@{
    ViewData["Title"] = "Perfil";
    var nombreCompleto = $"{Model?.primerNombre} {Model?.segundoNombre} {Model?.apellidoPaterno} {Model?.apellidoMaterno}".Trim();
    var tipoDoc = Model?.tipoDocumento != "C" ? "PASAPORTE" : "CÉDULA";
}

<div class="w-100 container-main p-0">
    <!-- Banner de Perfil Institucional -->
    <div class="card border-0 shadow-sm border-radius-xl overflow-hidden" style="background: linear-gradient(135deg, #151b3d 0%, #1f295b 100%); border-left: 4px solid #c59b27 !important;">
        <div class="card-body p-4 text-white">
            <div class="row align-items-center">
                <div class="col-auto me-3 me-sm-0">
                    <div id="fotoPerfilSection">
                        <div class="avatar portal-avatar-box shadow-md overflow-hidden d-flex align-items-center justify-content-center">
                            @if (!string.IsNullOrEmpty(Model?.archivofoto))
                            {
                                <img src="~/@Model.archivofoto?v=@DateTime.Now.Ticks" class="w-100 h-100 rounded-circle" style="object-fit: cover; object-position: center;" alt="Perfil" onerror="this.parentElement.innerHTML='<i class=\'bi-person-fill\'></i>';" />
                            }
                            else
                            {
                                <i class="bi-person-fill"></i>
                            }
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge border border-white-50 text-white font-weight-bold text-xxs uppercase tracking-wider" id="tipo" name="tipo" style="background: rgba(255, 255, 255, 0.15);">@tipoDoc</span>
                        <span class="text-white opacity-8 text-xs font-mono" id="idAlumno" name="idAlumno">@(Model?.idAlumno ?? "--")</span>
                    </div>
                    <h3 class="text-white mb-0 font-weight-bold" style="letter-spacing: -0.01em;">
                        <span id="nombres" name="nombres">@($"{Model?.primerNombre} {Model?.segundoNombre}".Trim())</span> <span id="apellidos" name="apellidos">@($"{Model?.apellidoPaterno} {Model?.apellidoMaterno}".Trim())</span>
                    </h3>
                    <p class="text-white-50 text-xs mb-0 mt-1">Estudiante ISTPET • Portal Académico</p>
                </div>
                <div class="col-12 col-md-auto mt-2 mt-md-0 text-md-end">
                    <a class="btn btn-white text-primary font-weight-bold border-radius-md px-3 py-2 shadow-sm btn-sm spf-link" href="~/Sistema/EditarPerfil" style="background: #ffffff !important; color: #1f295b !important; border: 1px solid #e2e8f0;">
                        <i class="bi-pencil-square me-1" style="color: #c59b27;"></i> Editar Datos
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Grilla de Tarjetas de Información -->
    <div class="row g-3 p-0 m-0" style="margin-top: 0 !important;">
        <!-- Tarjeta de Contacto y Ubicación -->
        <div class="col-lg-8 ps-0 pe-lg-2">
            <div class="card shadow-sm border-0 border-radius-xl h-100">
                <div class="card-header bg-transparent py-3 px-4 border-bottom border-light">
                    <div class="d-flex align-items-center gap-3">
                        <div class="portal-card-icon-box" style="width: 38px; height: 38px; min-width: 38px; min-height: 38px;">
                            <i class="bi-person-lines-fill text-white fs-6"></i>
                        </div>
                        <h6 class="mb-0 text-dark font-weight-bold">Información de Contacto y Residencia</h6>
                    </div>
                </div>
                <div class="card-body p-3 px-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 border border-radius-lg bg-light-subtle">
                                <span class="text-xs text-uppercase text-secondary font-weight-bold d-block mb-1">
                                    <i class="bi-envelope-at me-1" style="color: #1f295b;"></i> Correo Institucional
                                </span>
                                <span class="text-sm font-weight-bold text-dark d-block text-truncate" id="email_institucional" name="email_institucional">@(string.IsNullOrEmpty(Model?.email_institucional) ? "SIN REGISTRO" : Model.email_institucional)</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border border-radius-lg bg-light-subtle">
                                <span class="text-xs text-uppercase text-secondary font-weight-bold d-block mb-1">
                                    <i class="bi-envelope me-1" style="color: #1f295b;"></i> Correo Personal
                                </span>
                                <span class="text-sm font-weight-bold text-dark d-block text-truncate" id="email" name="email">@(string.IsNullOrEmpty(Model?.email) ? "SIN REGISTRO" : Model.email)</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border border-radius-lg bg-light-subtle">
                                <span class="text-xs text-uppercase text-secondary font-weight-bold d-block mb-1">
                                    <i class="bi-phone me-1" style="color: #1f295b;"></i> Celular
                                </span>
                                <span class="text-sm font-weight-bold text-dark d-block" id="celular" name="celular">@(string.IsNullOrEmpty(Model?.celular) ? "SIN REGISTRO" : Model.celular)</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border border-radius-lg bg-light-subtle">
                                <span class="text-xs text-uppercase text-secondary font-weight-bold d-block mb-1">
                                    <i class="bi-telephone me-1" style="color: #1f295b;"></i> Teléfono Fijo
                                </span>
                                <span class="text-sm font-weight-bold text-dark d-block" id="telefono" name="telefono">@(string.IsNullOrEmpty(Model?.telefono) ? "SIN REGISTRO" : Model.telefono)</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border border-radius-lg bg-light-subtle">
                                <span class="text-xs text-uppercase text-secondary font-weight-bold d-block mb-1">
                                    <i class="bi-geo-alt me-1" style="color: #1f295b;"></i> Ciudad de Residencia
                                </span>
                                <span class="text-sm font-weight-bold text-dark d-block" id="ciudad_residencia" name="ciudad_residencia">@(string.IsNullOrEmpty(Model?.ciudad_residencia) ? "SIN REGISTRO" : Model.ciudad_residencia)</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 border border-radius-lg bg-light-subtle">
                                <span class="text-xs text-uppercase text-secondary font-weight-bold d-block mb-1">
                                    <i class="bi-map me-1" style="color: #1f295b;"></i> Dirección Domiciliaria
                                </span>
                                <span class="text-sm font-weight-bold text-dark d-block" id="direccion" name="direccion">@(string.IsNullOrEmpty(Model?.direccion) ? "SIN REGISTRO" : Model.direccion)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta de Seguridad -->
        <div class="col-lg-4 pe-0 ps-lg-2">
            <div class="card shadow-sm border-0 border-radius-xl h-100">
                <div class="card-header bg-transparent py-3 px-4 border-bottom border-light">
                    <div class="d-flex align-items-center gap-3">
                        <div class="portal-card-icon-box" style="width: 38px; height: 38px; min-width: 38px; min-height: 38px;">
                            <i class="bi-shield-lock-fill text-white fs-6"></i>
                        </div>
                        <h6 class="mb-0 text-dark font-weight-bold">Seguridad de la Cuenta</h6>
                    </div>
                </div>
                <div class="card-body p-3 px-4 d-flex flex-column justify-content-between">
                    <div>
                        <p class="text-xs text-secondary mb-3">Mantén tu cuenta protegida renovando tu contraseña periódicamente.</p>
                        <div class="p-3 border border-radius-lg bg-light mb-3">
                            <small class="text-xs text-muted d-block mb-1"><i class="bi-info-circle me-1" style="color: #c59b27;"></i> Recomendación</small>
                            <span class="text-xs text-dark d-block">Usa una combinación de mayúsculas, minúsculas y números (6 a 10 caracteres).</span>
                        </div>
                    </div>
                    <button class="btn btn-dark w-100 border-radius-md shadow-xs py-2 mt-2 btn-sm" id="btnClave" style="background: #1f295b !important; border: none;">
                        <i class="bi-key me-1"></i> Cambiar Contraseña
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Cambio de Contraseña -->
<div class="modal fade" id="modal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
    aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg border-radius-xl overflow-hidden">
            <div class="modal-header py-3 px-4 text-white" style="background: linear-gradient(135deg, #151b3d 0%, #1f295b 100%); border-bottom: 2px solid #c59b27;">
                <h6 class="modal-title text-white font-weight-bold mb-0 d-flex align-items-center gap-2" id="modalLabel">
                    <i class="bi-key-fill text-warning"></i> Cambiar Contraseña
                </h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label text-xs font-weight-bold text-dark mb-1" for="anterior">Contraseña anterior</label>
                        <input type="password" data-validate="no-espacios" class="form-control form-control-sm border-radius-md" id="anterior" name="anterior" placeholder="••••••••">
                        <div class="invalid-feedback">
                            * Campo requerido
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-xs font-weight-bold text-dark mb-1" for="password">Nueva contraseña</label>
                        <input type="password" data-validate="no-espacios" class="form-control form-control-sm border-radius-md" id="password" name="password" placeholder="••••••••">
                        <div class="invalid-feedback">
                            * Campo requerido
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-xs font-weight-bold text-dark mb-1" for="confir">Confirmar nueva contraseña</label>
                        <input type="password" data-validate="no-espacios" class="form-control form-control-sm border-radius-md" id="confir" name="confir" placeholder="••••••••">
                        <div class="invalid-feedback">
                            * Campo requerido
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer p-3 bg-light border-0">
                <button type="button" class="btn btn-light btn-sm border-radius-md px-3" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary btn-sm border-radius-md px-3" onclick="guardar()" style="background: #1f295b !important; border: none;">Cambiar Contraseña</button>
            </div>
        </div>
    </div>
</div>

<script defer src="~/js/siteCuenta.js?v=@DateTime.Now.Ticks"></script>

